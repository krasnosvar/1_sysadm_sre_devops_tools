# --- Terraform ---
**/.terraform/
**/.terraform.lock.hcl
*.tfstate
*.tfstate.*
*.tfplan
1_linux/2_services/1_infra_terraform_clouds/terraform/examples/libvirt/**/images/*

# --- Vendored SDKs / large downloads ---
1_linux/2_services/3_containers_and_orchestration/docker/examples/Dockerfiles/sqlplus/instantclient_21_4/
1_linux/2_services/3_containers_and_orchestration/docker/examples/Dockerfiles/sqlplus/instantclient_21_6/

.DS_Store
*.swp
*.swo
*~

# --- Build & profiling artifacts ---
*.prof
__pycache__/
*.pyc
*.bak

# Common local secret files. Commit explicit *.sample or *.example templates.
**/.env
**/.env.local

# Local workstation restore secrets; keep samples in git, never real values.
1_linux/fedora/private/*
!1_linux/fedora/private/
!1_linux/fedora/private/*.sample

# Claude Code local settings can capture machine-specific absolute paths
# (e.g. permission allow-rules with a full $HOME path); never commit those
# to a public repo.
.claude/settings.local.json
