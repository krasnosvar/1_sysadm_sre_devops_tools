# Managed fragment installed by update-mac.zsh.
export ZSH="${ZSH:-$HOME/.oh-my-zsh}"
ZSH_THEME="agnoster"
plugins=(git docker docker-compose zsh-autosuggestions zsh-syntax-highlighting)

if [[ -d "${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src" ]]; then
  fpath+=("${ZSH_CUSTOM:-$ZSH/custom}/plugins/zsh-completions/src")
fi
[[ -r "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

autoload -Uz compinit && compinit
command -v kubectl >/dev/null 2>&1 && source <(kubectl completion zsh)
command -v tofu >/dev/null 2>&1 && source <(tofu -install-autocomplete 2>/dev/null || true)

if command -v brew >/dev/null 2>&1; then
  brew_prefix="$(brew --prefix)"
  export PATH="$brew_prefix/opt/libpq/bin:$brew_prefix/opt/openjdk/bin:$PATH"
  export CPPFLAGS="-I$brew_prefix/opt/openjdk/include${CPPFLAGS:+ $CPPFLAGS}"
  unset brew_prefix
fi

# Refuse accidental recursive deletion; use `command rm` after checking a target.
alias rm='print -u2 "Use trash or: command rm <checked-target>"; false'
